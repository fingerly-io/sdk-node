{
  "name": "@fingerly/node",
  "version": "0.1.4",
  "publishConfig": { "access": "public" },
  "description": "Server-side Fingerly SDK for event reads, webhook verification, and same-origin proxying",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/fingerly-io/sdks.git", "directory": "server/node"},
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "prepack": "pnpm build",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.16"
  },
  "packageManager": "pnpm@9.0.0"
}
